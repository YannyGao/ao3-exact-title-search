{
  "manifest_version": 3,
  "name": "AO3 Exact Title Search",
  "version": "3.2.0",
  "description": "Make AO3's native search use contiguous exact title wording without changing the interface.",
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_title": "AO3 Exact Title Search",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://archiveofourown.org/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ]
}
